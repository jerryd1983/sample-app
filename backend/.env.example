# Port the Express server listens on
PORT=8080

# AWS region for DynamoDB
AWS_REGION=us-east-1

# DynamoDB table name
TASKS_TABLE=Tasks

# Allowed CORS origin. Use your Amplify URL in production, e.g. https://main.d123.amplifyapp.com
CORS_ORIGIN=*

# Optional: point to DynamoDB Local for offline development.
# Leave blank to use real AWS DynamoDB.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Only needed for DynamoDB Local (dummy credentials):
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
